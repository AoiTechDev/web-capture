{
  "name": "chrome-extension",
  "displayName": "Clerk Chrome Extension Demo",
  "version": "0.0.1",
  "description": "A feature rich implementation of Clerk with a Plasmo-based Chrome Extension.",
  "author": "Clerk",
  "scripts": {
    "build": "plasmo build && node scripts/check-manifest.mjs",
    "debug": "plasmo dev --verbose",
    "dev": "plasmo dev",
    "package": "node scripts/check-manifest.mjs --strict && plasmo package",
    "test": "vitest run"
  },
  "dependencies": {
    "@clerk/chrome-extension": "^2.6.0",
    "@huggingface/transformers": "4.3.0",
    "@radix-ui/react-slot": "^1.2.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "convex": "^1.27.3",
    "onnxruntime-web": "1.31.0-dev.20260914-8d85527a0",
    "plasmo": "^0.90.5",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.9.1",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "3",
    "webextension-polyfill": "^0.12.0"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "4.7.0",
    "@types/chrome": "^0.1.12",
    "@types/node": "^24.5.2",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@types/webextension-polyfill": "^0.12.3",
    "happy-dom": "^18",
    "path-browserify": "^1.0.0",
    "postcss": "^8.5.6",
    "prettier": "^3.6.2",
    "stream-browserify": "^3.0.0",
    "typescript": "^5.9.2",
    "util": "^0.12.3",
    "vitest": "^3.2.4"
  },
  "manifest": {
    "permissions": [
      "cookies",
      "storage",
      "activeTab",
      "tabs",
      "offscreen"
    ],
    "host_permissions": [
      "<all_urls>"
    ],
    "key": "$CRX_PUBLIC_KEY",
    "content_security_policy": {
      "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
    },
    "externally_connectable": {
      "matches": [
        "http://localhost/*"
      ]
    }
  }
}
